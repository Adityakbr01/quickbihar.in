{
  "name": "user-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "generate:manifest": "node ./scripts/generate-manifest.mjs",
    "build": "npm run generate:manifest && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "lighthouse": "node scripts/lighthouse.mjs --form-factor=both",
    "lighthouse:mobile": "node scripts/lighthouse.mjs --form-factor=mobile",
    "lighthouse:desktop": "node scripts/lighthouse.mjs --form-factor=desktop",
    "perf": "npm run build && node scripts/lighthouse.mjs --form-factor=both",
    "perf:mobile": "npm run build && node scripts/lighthouse.mjs --form-factor=mobile",
    "perf:desktop": "npm run build && node scripts/lighthouse.mjs --form-factor=desktop"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "schema-dts": "^2.0.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-prerender-plugin": "^0.5.14",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.5.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
