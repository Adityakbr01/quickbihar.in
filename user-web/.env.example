# ─────────────────────────────────────────────────────────
# QuickBihar — Mobile (Expo) Environment Template
# ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# All keys MUST be prefixed with EXPO_PUBLIC_ to be readable in the app
# (Expo convention). They are inlined at build time.
# Never commit a real `.env` to git.
# See docs/developers-docs/oauth.md for the full setup walkthrough.
# ─────────────────────────────────────────────────────────

# ── API origin (pick ONE; uncomment the active one) ─
# Production
EXPO_PUBLIC_API_ORIGIN=https://quickbihar.in

# Localhost (iOS simulator / Mac)
# EXPO_PUBLIC_API_ORIGIN=http://localhost:8000

# Android emulator (host loopback)
# EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:8000

# LAN (replace with your laptop's LAN IP — `ipconfig getifaddr en0` on Mac,
# `ipconfig` on Windows. The Expo dev tools print this on startup.)
# EXPO_PUBLIC_API_ORIGIN=http://10.56.21.27:8000

# ── Google OAuth (mobile) ──────────────────────────
# Android client ID — @react-native-google-signin/google-signin v15
# Get it from: Google Cloud → APIs & Services → Credentials → Android client.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_me-android-client-id.apps.googleusercontent.com

# iOS client ID — same source → iOS client.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_me-ios-client-id.apps.googleusercontent.com

# Web client ID (rare fallback; needed if you embed a web sign-in flow).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_me-web-client-id.apps.googleusercontent.com
